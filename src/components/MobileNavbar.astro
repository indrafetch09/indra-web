---
const isActive = (path: string) => {
    const current = Astro.url.pathname;
    if (path === "/") {
        return current === "/" || current === "";
    }
    return current.startsWith(path);
};
---

<!-- Mobile Nav -->
<div></div>
<nav
    id="mobile-nav"
    class="fixed top-12 left-0 right-0 font-light bg-panel border-b border-muted/50 p-6 md:hidden rounded-b-xl shadow-lg transition-all duration-300 ease-in-out transform -translate-y-full opacity-0 pointer-events-none"
>
    <ul class="flex flex-col gap-6 text-2xl">
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/") },
                    { "text-muted": !isActive("/") },
                ]}
                href="/"
                id="mobile-link-home">Home</a
            >
        </li>
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/about") },
                    { "text-muted": !isActive("/about") },
                ]}
                href="/about"
                id="mobile-link-about">About</a
            >
        </li>
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/project") },
                    { "text-muted": !isActive("/project") },
                ]}
                href="/project"
                id="mobile-link-project">Project</a
            >
        </li>
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/contact") },
                    { "text-muted": !isActive("/contact") },
                ]}
                href="/contact"
                id="mobile-link-contact">Contact</a
            >
        </li>
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/blog") },
                    { "text-muted": !isActive("/blog") },
                ]}
                href="/blog"
                id="mobile-link-blog">Blog</a
            >
        </li>
        <li>
            <a
                class:list={[
                    { "text-green": isActive("/opencode") },
                    { "text-muted": !isActive("/opencode") },
                ]}
                href="/opencode"
                id="mobile-link-opencode">Opencode</a
            >
        </li>
    </ul>
</nav>
